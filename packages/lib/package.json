{
  "name": "react-msaview",
  "author": "Colin",
  "version": "9.8.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/JBrowseMSA.git",
    "directory": "packages/lib"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "types": "src/index.ts",
  "files": [
    "dist",
    "bundle",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist bundle",
    "watch": "pnpm build:esm --watch",
    "format": "prettier --write .",
    "build:esm": "tsc --project tsconfig.build.json",
    "build:umd": "node esbuild.mjs",
    "build": "pnpm clean && pnpm build:esm && pnpm build:umd",
    "statedocs": "node --experimental-strip-types docgen/generateStateModelDocs.ts",
    "poststatedocs": "oxfmt apidocs",
    "test": "vitest"
  },
  "peerDependencies": {
    "@jbrowse/core": ">=5.0.0-0",
    "@jbrowse/mobx-state-tree": ">=6.0.0",
    "@mui/icons-material": ">=9.0.0",
    "@mui/material": ">=9.0.0",
    "mobx": ">=7.0.0",
    "mobx-react": ">=10.0.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "dist/index.d.ts",
    "main": "dist/index.js"
  },
  "devDependencies": {
    "@jbrowse/core": "^5.0.0-beta.15",
    "@jbrowse/mobx-state-tree": "^6.9.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "mobx": "^7.0.6",
    "mobx-react": "^10.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@gmod/newick": "^1.0.3",
    "@jbrowse/svgcanvas": "workspace:*",
    "colord": "^2.10.0",
    "flatbush": "^4.6.2",
    "msa-parsers": "workspace:*"
  }
}
