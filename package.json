{
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev": "pnpm --filter app dev",
    "watch": "pnpm -r --parallel --filter svgcanvas --filter msa-parsers --filter react-msaview --filter app run '/^(watch|dev)$/'",
    "build": "pnpm --filter svgcanvas build && pnpm --filter msa-parsers build && pnpm --filter react-msaview build && pnpm --filter react-msaview-cli build",
    "check:pack": "node scripts/check-pack.mjs",
    "check:media": "pnpm media:pull && node scripts/check-media-refs.mjs",
    "check:data": "node scripts/check-data-refs.mjs",
    "check:guide-links": "node scripts/screenshots/genGuideLinks.mjs --check",
    "check:tutorials": "node scripts/check-tutorials.mjs",
    "media:status": "node scripts/media-store/media.mjs status",
    "media:pull": "node scripts/media-store/media.mjs pull",
    "media:push": "node scripts/media-store/media.mjs push",
    "media:check": "node scripts/media-store/media.mjs check",
    "media:forget": "node scripts/media-store/media.mjs forget",
    "media:report": "node scripts/media-store/media.mjs report",
    "media:stale": "node scripts/media-store/media.mjs stale",
    "smoke:npm": "node scripts/npm-smoke.mjs",
    "sync:r-bundle": "node scripts/sync-r-bundle.mjs && node scripts/build-r-core.mjs",
    "build:lib": "pnpm --filter svgcanvas build && pnpm --filter msa-parsers build && pnpm --filter react-msaview build:esm",
    "build:site": "pnpm media:pull && pnpm --filter website build",
    "build:pages": "pnpm build:lib && pnpm build:site && pnpm --filter app build && node scripts/assemble-pages.mjs",
    "clean": "pnpm -r run clean",
    "lint": "oxlint -c .oxlintrc.json --type-aware --deny-warnings",
    "lint:fast": "oxlint -c .oxlintrc.json --deny-warnings",
    "format": "oxfmt . && prettier --write \"website/**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"website/**/*.astro\"",
    "test": "vitest",
    "figures": "vitest run --config vitest.figures.config.ts",
    "figures:check": "FIGURES_CHECK=1 vitest run --config vitest.figures.config.ts",
    "examples:gen": "node scripts/examples-gen/generate.mjs",
    "screenshots": "pnpm media:pull && node scripts/screenshots/writeExampleData.mjs && pnpm --filter app exec vite build && node scripts/screenshots/generate.mjs",
    "screenshots:all": "pnpm media:pull && node scripts/screenshots/generate-screenshots.mjs",
    "screenshots:jbrowse": "node scripts/screenshots/jbrowse-figures.mjs",
    "typecheck": "pnpm -r --filter=!website exec tsc --noEmit && tsc -p packages/lib/docgen && pnpm --filter website exec astro sync && pnpm --filter website exec tsc --noEmit",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "attw": "pnpm -r --filter react-msaview --filter msa-parsers --filter @jbrowse/svgcanvas exec attw --pack . --ignore-rules cjs-resolves-to-esm"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@emotion/react": "^11.14.0",
    "@jbrowse/core": "^5.0.0-beta.9",
    "@jbrowse/mobx-state-tree": "^6.6.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "flatbush": "^4.6.2",
    "git-cliff": "^2.14.2",
    "jsdom": "^30.1.1",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.0",
    "puppeteer-core": "^25.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "serve-handler": "^6.1.7",
    "slugify": "^1.6.9",
    "tss-react": "^4.9.21",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
