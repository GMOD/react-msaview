---
import Viewer from './Viewer.tsx'

const base = import.meta.env.BASE_URL
---

<div class="frame">
  <Viewer client:only="react" base={base} />
</div>
<p>
  Twelve NLRP1 orthologs with their InterPro domains and tree. Drag the
  alignment to scroll.
</p>

<style>
  .frame {
    border: 1px solid var(--border);
  }
</style>
