---
import type { MarkdownHeading } from 'astro'

interface Props {
  sections: MarkdownHeading[]
}
const { sections } = Astro.props
---

<aside aria-label="On this page">
  <p>On this page</p>
  <ul>
    {sections.map(h => (
      <li>
        <a href={`#${h.slug}`}>{h.text}</a>
      </li>
    ))}
  </ul>
</aside>

<style>
  aside {
    position: sticky;
    top: 64px;
    align-self: start;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
    font-size: 0.8rem;
  }
  p {
    margin: 0 0 6px;
    font-weight: 700;
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }
  a {
    display: block;
    padding: 3px 10px;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.35;
  }
  a:hover {
    color: var(--accent);
  }
  @media (max-width: 1200px) {
    aside {
      display: none;
    }
  }
</style>
