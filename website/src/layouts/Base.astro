---
import { app, docs, examples, guide, tutorials } from '../lib/links.ts'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  wide?: boolean
  fullBleed?: boolean
}
const { title, description, wide, fullBleed } = Astro.props
const base = import.meta.env.BASE_URL

const strip = (s: string) => s.replace(/\/$/, '')
const current = strip(Astro.url.pathname)
const isCurrent = (href: string) => strip(href) === current
const nav = [
  { ...guide, label: 'Docs', active: docs.some(d => isCurrent(d.href)) },
  {
    ...tutorials,
    active: current.startsWith(strip(tutorials.href)),
  },
  { ...examples, active: isCurrent(examples.href) },
  { ...app, active: false },
]
const canonical = new URL(Astro.url.pathname, Astro.site).href
const socialImage = new URL(
  `${base}/media/within-protein-conservation.png`,
  Astro.site,
).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JBrowseMSA" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body class:list={{ 'app-layout': fullBleed }}>
    <header class="site-header">
      <a class="brand" href={base}>
        JBrowseMSA
      </a>
      <nav aria-label="Primary">
        {nav.map(item => (
          <a
            href={item.href}
            class:list={{ active: item.active }}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <a
        class="github-icon"
        href="https://github.com/GMOD/JBrowseMSA"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      ></a>
    </header>
    <main class:list={{ wide, 'full-bleed': fullBleed }}>
      <slot />
    </main>
    <footer class="site-footer">
      <span>
        react-msaview (JBrowseMSA) ·
        <a href="https://github.com/GMOD/JBrowseMSA">GitHub</a> · part of
        <a href="https://jbrowse.org">JBrowse</a>
      </span>
    </footer>
  </body>
</html>
