---
import DocsLayout from '../../layouts/DocsLayout.astro'
import { tutorials } from '../../lib/tutorials.ts'

import type { Tutorial } from '../../lib/tutorials.ts'
import type { MarkdownInstance } from 'astro'

type Markdown = MarkdownInstance<Record<string, unknown>>

// tutorials.ts is the list; the glob only supplies the rendered markdown. The
// directory also holds CLAUDE.md, which is authoring instructions, not a page,
// and two entries are hand-written pages beside this one.
export function getStaticPaths() {
  const pages = import.meta.glob<Markdown>('../../../../docs/tutorials/*.md', {
    eager: true,
  })
  return tutorials.flatMap(tutorial => {
    const page = pages[`../../../../docs/tutorials/${tutorial.slug}.md`]
    return page
      ? [{ params: { slug: tutorial.slug }, props: { tutorial, page } }]
      : []
  })
}

const { tutorial, page } = Astro.props as { tutorial: Tutorial; page: Markdown }
const { Content } = page
---

<DocsLayout
  title={`${tutorial.title} — JBrowseMSA`}
  description={tutorial.blurb}
  headings={page.getHeadings()}
>
  <Content />
</DocsLayout>
