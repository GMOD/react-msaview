---
// The site's gallery as well as its table of contents: a walkthrough is the
// only place a figure comes with the commands that produced it, so the
// showcase is the list of walkthroughs rather than a separate wall of
// screenshots. Each card's image is one of that page's own figures, cropped to
// 5:3 and re-encoded by astro:assets at build time (see lib/tutorials.ts).
import { Image } from 'astro:assets'

import DocsLayout from '../../layouts/DocsLayout.astro'
import { tutorialCategories, tutorials } from '../../lib/tutorials.ts'

const base = import.meta.env.BASE_URL
const sections = tutorialCategories.map(category => ({
  category,
  items: tutorials.filter(t => t.category === category),
}))
---

<DocsLayout
  title="Tutorials — JBrowseMSA"
  description="End-to-end walkthroughs that prepare the data outside the viewer: sequences to alignment to tree to annotations, ending on a link that opens the result."
>
  <h1>Tutorials</h1>
  <p>
    Each walkthrough prepares the data with command-line tools, from sequences
    to an alignment, a tree and annotations, and ends on a link that opens the
    result in JBrowseMSA.
  </p>

  {sections.map(({ category, items }) => (
    <section>
      <h2>{category}</h2>
      <ul class="tutorial-index">
        {items.map(t => {
          const href = `${base}/tutorials/${t.slug}`
          return (
            <li>
              <a href={href} class="thumb-link">
                <Image
                  src={t.thumb}
                  alt={t.thumbAlt}
                  width={640}
                  height={384}
                  fit="cover"
                  position={t.thumbPosition}
                  format="webp"
                  loading="lazy"
                />
              </a>
              <a href={href} class="tut-title">
                {t.title}
              </a>
              <p>{t.blurb}</p>
            </li>
          )
        })}
      </ul>
    </section>
  ))}

  <p>
    See also the <a href={`${base}/layers`}>layers reference</a> and the
    <a href={`${base}/examples`}>examples</a>.
  </p>
</DocsLayout>

<style>
  .tutorial-index {
    list-style: none;
    margin: 16px 0 32px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 28px 24px;
  }
  .tutorial-index li {
    margin: 0;
  }
  .thumb-link {
    display: block;
  }
  .tutorial-index img {
    display: block;
    width: 100%;
    height: auto;
  }
  .tut-title {
    display: block;
    margin: 10px 0 4px;
    font-weight: 600;
    line-height: 1.3;
  }
  .tutorial-index p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--muted);
  }
</style>
