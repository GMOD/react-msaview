---
import HomeDemo from '../components/HomeDemo.astro'
import LinkList from '../components/LinkList.astro'
import Base from '../layouts/Base.astro'
import { app, docs, examples, tutorials } from '../lib/links.ts'
---

<Base
  title="JBrowseMSA — multiple sequence alignment viewer"
  description="Interactive multiple sequence alignment viewer with phylogenetic tree, protein domains, and many color schemes. React, HTML, and R."
>
  <article class="prose">
    <h1>JBrowseMSA</h1>
    <p>
      An interactive multiple sequence alignment viewer with a phylogenetic
      tree, protein domains and many color schemes, scaling to tens of thousands
      of rows.
    </p>

    <HomeDemo />

    <LinkList items={[app, tutorials, examples, ...docs]} />
  </article>
</Base>
